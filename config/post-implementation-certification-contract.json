{
  "schema_version": 1,
  "contract_id": "datanexus-post-implementation-certification-v1",
  "scope": "entire-platform",
  "principles": {
    "fail_closed": true,
    "exact_head_required": true,
    "independent_assurance_required": true,
    "production_validation_required_when_applicable": true,
    "not_measured_is_not_pass": true,
    "no_self_certification_for_independent_gates": true,
    "no_threshold_weakening": true,
    "evidence_must_be_persisted": true
  },
  "status_model": [
    "NOT_MEASURED",
    "BLOCKED_EXTERNAL",
    "BLOCKED_POLICY",
    "FAILED",
    "PASSED"
  ],
  "completion_gates": [
    "static_and_contract_validation",
    "unit_and_property_tests",
    "negative_and_failure_tests",
    "state_transition_and_concurrency_tests",
    "tenant_authorization_and_security_validation",
    "migration_and_clean_database_reconstruction",
    "integration_and_end_to_end_validation",
    "ai_evaluation_and_prompt_injection_red_team",
    "compromised_agent_and_tool_misuse_audit",
    "recovery_rollback_and_compensation_validation",
    "chaos_and_dependency_failure_validation",
    "shadow_and_canary_validation",
    "independent_adversarial_assurance",
    "exact_head_ci",
    "preview_validation_when_applicable",
    "production_validation_when_applicable",
    "evidence_and_documentation_refresh"
  ],
  "platform_domains": [
    {
      "id": "identity_access_tenancy",
      "mandatory": true,
      "evidence": ["authorization_tests", "tenant_isolation_tests", "service_role_acl", "security_definer_allowlist", "negative_access_tests"]
    },
    {
      "id": "catalog_metadata_lineage",
      "mandatory": true,
      "evidence": ["contract_tests", "referential_integrity", "lineage_authority", "reconciliation_tests", "negative_write_boundary_tests"]
    },
    {
      "id": "source_onboarding_connectivity",
      "mandatory": true,
      "evidence": ["source_readiness", "connector_tests", "file_onboarding", "jdbc_validation", "failure_and_timeout_tests"]
    },
    {
      "id": "profiling_quality_semantics",
      "mandatory": true,
      "evidence": ["profiling_lifecycle", "quality_rules", "semantic_validation", "reprofile_validation", "scale_and_failure_tests"]
    },
    {
      "id": "governance_policy_workflows",
      "mandatory": true,
      "evidence": ["policy_contracts", "approval_validity", "control_operability", "workflow_state_tests", "audit_evidence"]
    },
    {
      "id": "agents_orchestration_autonomy",
      "mandatory": true,
      "evidence": ["agent_portfolio", "handoff_integrity", "entry_exit_gates", "blast_radius", "recovery_revalidation", "compromised_agent_audit"]
    },
    {
      "id": "ai_retrieval_routing_models",
      "mandatory": true,
      "evidence": ["provider_contracts", "routing_policy", "retrieval_grounding", "budget_controls", "ai_evaluation", "red_team"]
    },
    {
      "id": "evidence_reporting_certification",
      "mandatory": true,
      "evidence": ["canonical_evidence", "unsupported_claim_suppression", "report_consistency", "independent_certification", "audit_traceability"]
    },
    {
      "id": "runtime_resilience_recovery",
      "mandatory": true,
      "evidence": ["durable_state", "idempotency", "fencing", "retry_bounds", "rollback_compensation", "chaos_validation"]
    },
    {
      "id": "observability_audit_operations",
      "mandatory": true,
      "evidence": ["decision_telemetry", "audit_logging", "slo_validation", "incident_recovery", "operational_evidence"]
    },
    {
      "id": "database_migrations_data_integrity",
      "mandatory": true,
      "evidence": ["forward_only_migrations", "clean_reconstruction", "foreign_keys", "indexes", "rls_security", "data_integrity_tests"]
    },
    {
      "id": "release_deployment_production",
      "mandatory": true,
      "evidence": ["exact_head_ci", "dependency_security", "preview_validation", "canary_or_shadow", "production_revalidation", "rollback_readiness"]
    }
  ],
  "required_repository_controls": {
    "workflows": [
      ".github/workflows/quality-gate.yml",
      ".github/workflows/p0-p4-revalidation.yml",
      ".github/workflows/v6-operational-certification.yml",
      ".github/workflows/repository-governance.yml",
      ".github/workflows/ai-governance-program-certification.yml"
    ],
    "scripts": [
      "scripts/ci-full-quality-gate.sh",
      "scripts/verify-p0-p4-revalidation.mjs"
    ]
  },
  "decision_rules": {
    "certify_only_if_all_mandatory_gates_pass": true,
    "blocked_or_not_measured_mandatory_gate_blocks_certification": true,
    "failed_mandatory_gate_blocks_certification": true,
    "production_only_claims_require_production_evidence": true,
    "recovery_does_not_imply_original_step_success": true,
    "evidence_timestamp_must_not_predate_certified_revision": true
  },
  "best_practice_alignment": [
    "NIST_SP_800_218_SSDF",
    "NIST_CSF_2_0",
    "OWASP_ASVS",
    "OWASP_LLM_TOP_10",
    "SLSA_BUILD_PROVENANCE",
    "CIS_SOFTWARE_SUPPLY_CHAIN_GUIDANCE"
  ]
}
