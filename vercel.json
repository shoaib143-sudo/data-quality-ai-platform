{
  "buildCommand": "pnpm build && node scripts/generate-deployed-artifact-provenance.mjs",
  "regions": [
    "sin1"
  ],
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "ux/*": true,
      "preview/*": true,
      "feat/ui-*": true,
      "fix/ui-*": true,
      "feat/frontend-*": true,
      "fix/frontend-*": true
    }
  },
  "crons": [
    {
      "path": "/api/internal/governance/approval-automation",
      "schedule": "15 0 * * *"
    }
  ]
}
