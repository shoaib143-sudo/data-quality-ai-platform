{
  "schemaVersion": 2,
  "claimLevels": ["IMPLEMENTED", "CERTIFIED", "PRODUCTION_VERIFIED"],
  "requiredProtectedContexts": ["build", "analyze", "revalidate", "certify"],
  "requiredProductionAcceptancePaths": ["NORMAL", "ADVERSARIAL", "DEGRADED"],
  "requiredProductionEvidenceClasses": [
    "SOURCE_IDENTITY",
    "EXACT_HEAD_CERTIFICATION",
    "DEPLOYED_ARTIFACT_PROVENANCE",
    "DEPLOYMENT_BINDING",
    "DATABASE_MIGRATION_BINDING",
    "RUNTIME_CONFIGURATION_BINDING",
    "AUTHENTICATED_JOURNEY",
    "ADVERSARIAL_JOURNEY",
    "DEGRADED_JOURNEY",
    "PERSONA_PRODUCTION_EVIDENCE",
    "RECOVERY_EVIDENCE",
    "RESIDUAL_RISK_SNAPSHOT"
  ],
  "productionRules": {
    "expectedRepository": "shoaib143-sudo/data-quality-ai-platform",
    "expectedProtectedBranch": "main",
    "expectedDeploymentProvider": "vercel",
    "expectedCanonicalProductionAlias": "data-quality-ai-platform.vercel.app",
    "evidenceFreshnessHours": 24,
    "sourceCommitMustBeFortyHex": true,
    "certificationHeadMustEqualSourceCommit": true,
    "buildSourceMustEqualSourceCommit": true,
    "buildProvenanceMustBeFreshPass": true,
    "referenceBuildMaySatisfyDeployedArtifactProvenance": false,
    "deploymentSourceMustEqualSourceCommit": true,
    "deploymentEnvironment": "production",
    "deploymentState": "READY",
    "deploymentEvidenceMustBeFreshPass": true,
    "databaseMustBindDeploymentId": true,
    "databaseEvidenceMustBeFreshPass": true,
    "runtimeMustBindDeploymentId": true,
    "runtimeEvidenceMustBeFreshPass": true,
    "journeyEvidenceMustBindDeploymentId": true,
    "personaEvidenceMustBindDeploymentId": true,
    "recoveryEvidenceMustBindDeploymentId": true,
    "previewEvidenceMaySatisfyProduction": false,
    "notMeasuredMaySatisfyRequiredEvidence": false,
    "staleEvidenceMaySatisfyRequiredEvidence": false,
    "residualRiskSnapshotRequired": true,
    "openR3ResidualRiskAllowed": false,
    "expiredResidualRiskAllowed": false,
    "recoveryEvidenceRequired": true,
    "migrationSetHashRequired": true,
    "artifactDigestRequired": true,
    "callerMayOverrideClockOrFreshness": false,
    "ledgerClaimRowsAreGovernanceAuthority": false,
    "ledgerAuthorityState": "EVIDENCE_ONLY",
    "directServiceRoleInsertAllowed": false
  },
  "personaPolicy": {
    "formalPersonas": [
      "senior-leadership",
      "business-user",
      "data-owner",
      "data-product-owner",
      "data-steward",
      "data-governance-specialist",
      "compliance-risk-officer",
      "privacy-security-officer",
      "data-governance-admin",
      "data-custodian",
      "source-system-owner",
      "metadata-analyst",
      "data-quality-analyst"
    ],
    "allFormalPersonasRequiredForProductionVerification": true
  },
  "recoveryAuthority": "infra/recovery/full-platform-recovery-contract.json",
  "topologyAuthority": "infra/recovery/platform-manifest.json"
}
