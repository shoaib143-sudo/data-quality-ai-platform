{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "datanexus-worker-canary",
  "main": "src/router.ts",
  "compatibility_date": "2026-09-19",
  "vars": {
    "DATANEXUS_ENV": "canary",
    "DATANEXUS_PLATFORM": "cloudflare",
    "DATANEXUS_WORKER_EXECUTION_ENABLED": "false",
    "DATANEXUS_WORKER_CANARY_JOB_TYPE": "OBSERVABILITY",
    "NEXT_PUBLIC_SUPABASE_URL": "https://tvjnavjxuehpesxcfvrx.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_ieDM8jckP5nlIORLW7gnVA_ZSHfwFZq"
  },
  "containers": [
    {
      "class_name": "DataNexusWorkerContainer",
      "image": "../../../Dockerfile",
      "max_instances": 1,
      "constraints": {
        "regions": [
          "APAC"
        ]
      },
      "instance_type": "standard-1",
      "ssh": {
        "enabled": false
      },
      "image_vars": {
        "NEXT_PUBLIC_SUPABASE_URL": "https://tvjnavjxuehpesxcfvrx.supabase.co",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_ieDM8jckP5nlIORLW7gnVA_ZSHfwFZq"
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DATANEXUS_WORKER",
        "class_name": "DataNexusWorkerContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DataNexusWorkerContainer"
      ]
    }
  ]
}
