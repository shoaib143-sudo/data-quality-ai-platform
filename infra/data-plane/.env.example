# Local/staging data-plane bootstrap only. Do not commit real secrets.

OPENSEARCH_INITIAL_ADMIN_PASSWORD=replace-with-strong-local-password
OPENSEARCH_ENDPOINT=https://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=replace-with-strong-local-password
OPENSEARCH_INDEX_PREFIX=datanexus

CLICKHOUSE_DATABASE=datanexus
CLICKHOUSE_USER=datanexus
CLICKHOUSE_PASSWORD=replace-with-strong-local-password
CLICKHOUSE_ENDPOINT=http://localhost:8123
CLICKHOUSE_ANALYTICS_EVENTS_TABLE=analytics_events

# Runtime provider selection. PostgreSQL remains authoritative.
KNOWLEDGE_SEARCH_PROVIDER=opensearch
GRAPH_PROVIDER=postgres
ANALYTICS_PROVIDER=clickhouse
OBJECT_STORE_PROVIDER=supabase
