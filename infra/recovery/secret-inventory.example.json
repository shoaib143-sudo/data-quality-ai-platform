{
  "schemaVersion": 1,
  "description": "Names and ownership only. Never commit secret values.",
  "requiredSecretNames": {
    "githubActionsRecovery": [
      "RECOVERY_SOURCE_DATABASE_URL",
      "RECOVERY_TARGET_DATABASE_URL",
      "RECOVERY_PROJECT_ID"
    ],
    "runtime": [
      "NEXT_PUBLIC_SUPABASE_URL",
      "SUPABASE_SERVICE_ROLE_KEY",
      "OPA_AUTH_TOKEN",
      "OTEL_EXPORTER_OTLP_HEADERS"
    ]
  },
  "rules": {
    "secretValuesAllowed": false,
    "rotateAfterExposure": true,
    "verifyPresenceDuringRecovery": true
  }
}
